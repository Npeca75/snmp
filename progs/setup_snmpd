#!/bin/bash

TAG=Monitoring
PRIO=daemon.info

logger -s -t "$TAG" -p "$PRIO" "Stop Services ..."
systemctl stop snmpd; service snmpd stop
systemctl stop lldpd; service lldpd stop

logger -s -t "$TAG" -p "$PRIO" "Prepare Common"

# shellcheck source=/dev/null
source /opt/snmp/snmp.data
PROGLOC=/opt/snmp/progs
TMPDIR=/tmp/snmptmp

rm -fr "$TMPDIR"; mkdir -p "$TMPDIR"
chmod +x "$PROGLOC"
rm -f /etc/cron.d/snmp

NL=$'\n'
LL="$NL"

IP6=$(ip -6 a show dev $gMGMTIF 2>/dev/null | grep 'scope global'|xargs|cut -d' ' -f2|cut -d'/' -f1)
IP4=$(ip -4 a show dev $gMGMTIF 2>/dev/null | grep 'inet'|xargs|cut -d' ' -f2|cut -d'/' -f1)
if [[ -z "$IP6" ]]; then 
    MGMTIP="$IP4"; COM2SEC="com2sec ro ${IP4}/32";
else
    MGMTIP="$IP6"; COM2SEC="com2sec6 ro ${IP6}/128";
fi
SYSLOC="${gCITY} [${gLON},${gLAT}]"

logger -s -t "$TAG" -p "$PRIO" "MGMT IP: $MGMTIP"

${PROGLOC}/snmpc_ifindex
echo "*/3 * * * * root ${PROGLOC}/snmpc_ifindex > ${TMPDIR}/cron_ifindex.log 2>&1 &" >> /etc/cron.d/snmp
${PROGLOC}/snmpc_ifalias
echo "1-58/3 * * * * root ${PROGLOC}/snmpc_ifalias > ${TMPDIR}/cron_ifalias.log 2>&1 &" >> /etc/cron.d/snmp
${PROGLOC}/snmpc_vlans
echo "2-59/3 * * * * root ${PROGLOC}/snmpc_vlans > ${TMPDIR}/cron_vlans.log 2>&1 &" >> /etc/cron.d/snmp
${PROGLOC}/snmpc_names
echo "*/45 * * * * root ${PROGLOC}/snmpc_fdb > ${TMPDIR}/cron_fdb.log 2>&1 &" >> /etc/cron.d/snmp
${PROGLOC}/snmpc_qbridge
echo "*/25 * * * * root ${PROGLOC}/snmpc_qbridge > ${TMPDIR}/cron_qbridge.log 2>&1 &" >> /etc/cron.d/snmp
${PROGLOC}/snmpc_fdb
echo "*/15 * * * * root ${PROGLOC}/snmpc_fdb > ${TMPDIR}/cron_fdb.log 2>&1 &" >> /etc/cron.d/snmp

[ -n "$(which smartctl)" ] && {
    LL="${LL}${NL}extend smart ${PROGLOC}/smart -c /etc/snmp/smart.config";
    ${PROGLOC}/smart -gC > /etc/snmp/smart.config
    echo "3 */6 * * * root ${PROGLOC}/smart -c /etc/snmp/smart.config -u" >> /etc/cron.d/snmp
}
[ ! -z $(which pvesm) ] && {
    LL="${LL}${NL}extend proxmox_disks ${PROGLOC}/proxmox_disks"
    echo "*/6 * * * * root ${PROGLOC}/proxmox_disks u" >> /etc/cron.d/snmp
}
[ ! -z $(which qm) ] && {
    LL="${LL}${NL}extend proxmox_vminfo ${PROGLOC}/proxmox_vminfo"
    echo "*/7 * * * * root ${PROGLOC}/proxmox_vminfo u" >> /etc/cron.d/snmp
}

[ ! -z $(which docker) ] && LL="${LL}${NL}extend docker ${PROGLOC}/docker-stats.sh"
[ ! -z $(which upsc) ] && LL="${LL}${NL}extend ups-nut ${PROGLOC}/ups-nut.sh"
[ ! -z $(which mysqld) ] && LL="${LL}${NL}extend mysql ${PROGLOC}/mysql"
[ ! -z $(which ethtool) ] && LL="${LL}${NL}extend transceivers ${PROGLOC}/transceivers"
ls /dev/md* 2>/dev/null && LL="${LL}${NL}extend mdadm ${PROGLOC}/mdadm"

HN=$(hostname -f)
LDES="sysDescr Linux"
[ ! -z $(which pvesm) ] && LDES="$LDES $(uname -r)" || LDES="$LDES $(uname -r|cut -d'-' -f1)"
[ ! -z "$SYSDES" ] && LDES="$LDES | $SYSDES"

logger -s -t "$TAG" -p "$PRIO" "Config write"
mkdir -p /etc/snmp
cat <<EOF > /etc/snmp/snmpd.conf

${COM2SEC} ${COM}
com2sec ro 169.254.${gZLC}.0/24 ${COM}
com2sec rw 169.254.255.30/32 W${COM}
com2sec6 ro fdfd:0:${gZLC}::/48 ${COM}
com2sec6 rw fdfd:1:255::/64 ${COM}
com2sec6 rw fdfd:1:255::30/128 W${COM}
#
group read v1 ro
group read v2c ro
group read usm ro
group write v1 rw
group write v2c rw
group write usm rw
view all included .1
#
access read "" any noauth exact all none all
access write "" any noauth exact all all all

agentaddress UDP6:161,UDP:161
master agentx
#agentXSocket /var/run/agentx.sock
agentXSocket /var/agentx/master
agentxperms 777 777

syslocation $SYSLOC
syscontact $SYSCON
sysName $HN
$LDES

extend .1.3.6.1.4.1.2021.7890.1 distro ${PROGLOC}/distro
extend .1.3.6.1.4.1.2021.7890.2 hardware '/bin/cat /sys/devices/virtual/dmi/id/product_name'
extend .1.3.6.1.4.1.2021.7890.3 manufacturer '/bin/cat /sys/devices/virtual/dmi/id/sys_vendor'
extend .1.3.6.1.4.1.2021.7890.4 serial '/bin/cat /sys/devices/virtual/dmi/id/bios_date'
${LL}

pass_persist .1.3.6.1.2.1.17.1.4.1.2 ${PROGLOC}/snmp_ifindex
pass_persist .1.3.6.1.2.1.17.7.1.1.1 ${PROGLOC}/snmp_vlansVersion
pass_persist .1.3.6.1.2.1.17.7.1.2.2.1.2 ${PROGLOC}/snmp_fdb
pass_persist .1.3.6.1.2.1.17.7.1.4.2.1.4 ${PROGLOC}/snmp_vlansMembers
pass_persist .1.3.6.1.2.1.17.7.1.4.2.1.5 ${PROGLOC}/snmp_vlansUntaggeds
pass_persist .1.3.6.1.2.1.17.7.1.4.3.1.1 ${PROGLOC}/snmp_vlansNames
pass_persist .1.3.6.1.2.1.31.1.1.1.18 ${PROGLOC}/snmp_ifalias
EOF

OPTS="-LS5d -Lf /dev/null -u root -g root -I -smux,mteTrigger,mteTriggerConf -p /run/snmpd.pid"
logger -s -t "$TAG" -p "$PRIO" "SNMP Defaults write: $OPTS"
echo "SNMPDOPTS='$OPTS'" > /etc/default/snmpd
#
mkdir -p /etc/systemd/system/snmpd.service.d
cat <<EOF > /etc/systemd/system/snmpd.service.d/override.conf
[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/run/agentx
ExecStart=
ExecStart=/usr/sbin/snmpd -f $OPTS
# ExecReload=/bin/kill -HUP $MAINPID
EOF

#
logger -s -t "$TAG" -p "$PRIO" "LLDP Prepare"
mkdir -p /etc/lldpd.d

HN=$(hostname -f)

IFPAT="et*,en*,en*,tap*,veth*,fwbr*"
[ "$TYPE" = "plain" ] && [ ! -f ${TMPDIR}/base_ifs ] && {
    IFPAT="vlan*"
}

logger -s -t "$TAG" -p "$PRIO" "LLDP Config write"
cat <<EOF > /etc/lldpd.d/lldpd.conf
configure lldp portidsubtype ifname
configure system interface pattern ${IFPAT}
configure system hostname '${HN}'
unconfigure system interface description
configure system ip management pattern $MGMTIP
configure med location coordinate latitude ${gLAT}N longitude ${gLON}E altitude 100 m datum WGS84
configure med location address country RS street 'unknown' city '${gCITY}'
EOF

logger -s -t "$TAG" -p "$PRIO" "LLDP Defaults write"
echo "DAEMON_ARGS=\"-l -i -M 4 -x -O /etc/lldpd.d/lldpd.conf\"" > /etc/default/lldpd

logger -s -t "$TAG" -p "$PRIO" "Start Services"
systemctl daemon-reload
systemctl restart snmpd
systemctl restart lldpd

logger -s -t "$TAG" -p "$PRIO" "Done"
