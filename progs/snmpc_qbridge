for v in $VLANS; do
    if [ -z "$oldidx" ]; then
        echo "getnext_13612117714215=${PLACE}.${v}" > "$TMP_OUT"
    else
        echo "getnext_${BASEC}${oldidx}=${PLACE}.${v}" >> "$TMP_OUT"
    fi

    eval INTS=\$"INTU$v"
    echo "Vlan: $v Ints: $INTS" >> "$DFILE"

    for et in $INTS; do
        port_idx=$(cat /sys/class/net/${et}/ifindex)
        [ -z "$port_idx" ] && continue
        let i=$(($port_idx/4))*4
        let i=$port_idx-$i
        eval O=\$"P$i"
        let PG=$(($(($port_idx-1))/4))+1
        echo "port_idx: $port_idx | Index: $i | Value: $O | group: $PG" >> "$DFILE"
        eval "let OUT$PG="\$"OUT$PG+$O"
    done

    pc=0; STR="";
    for g in $(seq 1 32); do
        eval O=\$"OUT$g"
        eval "OUT$g=''"
        [ -z "$O" ] && O="0"
        [ "$pc" = "2" ] && { pc=0; STR="$STR "; }
        STR=$STR$(printf '%x' $O)
        let pc=$pc+1
    done
    [ "$pc" = "1" ] && STR="${STR}0"
    echo "Vlan: $v OID: $STR" >> "$DFILE"
    echo "value_${BASEC}${v}='$STR'" >> "$TMP_OUT"
    echo "type_${BASEC}${v}='octetstring'" >> "$TMP_OUT"
    oldidx=$v
done
echo "getnext_${BASEC}${v}='NONE'" >> "$TMP_OUT"
mv "$TMP_OUT" "$FILE"
