#!/bin/bash

if [ -f "/opt/snmp/snmp.data" ]; then
    . /opt/snmp/snmp.data
else
    gZLC=$(printf "%02d" $(($(uci -q get system.@system[0].locid)+0)))
    gDSA=$(($(uci -q get system.@system[0].dsa)+0))
fi

TMPDIR=/tmp/snmptmp
mkdir -p "${TMPDIR}"

NFILE="${TMPDIR}/vlan_numbers"
IFILE="${TMPDIR}/vlan_interfaces"

VLANS="$(cat $NFILE)"
. "$IFILE"

FILE="${TMPDIR}/out_vlansMembers"
DFILE="${TMPDIR}/dbg_vlansMembers"
PLACE="1.3.6.1.2.1.17.7.1.4.2.1.4.0"
BASEC=$(printf '%s' "$PLACE" | tr -d '.')
TMP_OUT="${TMPDIR}/.tmp_vlansMembers_out.$$"

oldidx=""; P0=1; P1=8; P2=4; P3=2
for v in $VLANS; do
    if [ -z "$oldidx" ]; then
        echo "getnext_13612117714214=${PLACE}.${v}" > "$TMP_OUT"
    else
        echo "getnext_${BASEC}${oldidx}=${PLACE}.${v}" >> "$TMP_OUT"
    fi

    eval INTS=\$"INTM$v"
    echo "Vlan: $v Ints: $INTS" >> "$DFILE"

    for et in $INTS; do
        port_idx=$(cat /sys/class/net/${et}/ifindex)
        let i=$(($port_idx/4))*4
        [ -z "$port_idx" ] && continue
        let i=$port_idx-$i
        eval O=\$"P$i"
        let PG=$(($(($port_idx-1))/4))+1
        echo "port_idx: $port_idx | Index: $i | Value: $O | group: $PG" >> "$DFILE"
        eval "let OUT$PG="\$"OUT$PG+$O"
    done

    pc=0; STR="";
    for g in $(seq 1 32); do
        eval O=\$"OUT$g"
        eval "OUT$g=''"
        [ -z "$O" ] && O="0"
        [ "$pc" = "2" ] && { pc=0; STR="$STR "; }
        STR=$STR$(printf '%x' $O)
        let pc=$pc+1
    done
    [ "$pc" = "1" ] && STR="${STR}0"
    echo "Vlan: $v OID: $STR" >> "$DFILE"
    echo "value_${BASEC}${v}='$STR'" >> "$TMP_OUT"
    echo "type_${BASEC}${v}='octetstring'" >> "$TMP_OUT"
    oldidx=$v
    done
echo "getnext_${BASEC}${v}='NONE'" >> "$TMP_OUT"
mv "$TMP_OUT" "$FILE"

FILE="${TMPDIR}/out_vlansUntaggeds"
DFILE="${TMPDIR}/dbg_vlansUntaggeds"
PLACE="1.3.6.1.2.1.17.7.1.4.2.1.5.0"
BASEC=$(printf '%s' "$PLACE" | tr -d '.')
