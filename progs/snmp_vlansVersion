#!/bin/sh

if [ -f "/opt/snmp/snmp.data" ]; then
    . /opt/snmp/snmp.data
else
    gZLC=$(printf "%02d" $(($(uci -q get system.@system[0].locid)+0)))
    gDSA=$(($(uci -q get system.@system[0].dsa)+0))
fi

PLACE="1.3.6.1.2.1.17.7.1.1.1"
TMPDIR=/tmp/snmptmp
FILE=$TMPDIR/out_vlansVersion

export getnext_136121177111="${PLACE}.0"
export value_1361211771110='1'
export type_1361211771110='integer'
export getnext_1361211771110='NONE'

while read -r CMD; do
    case "$CMD" in
        PING)
            echo PONG
            continue
            ;;
        getnext)
            read -r REQ
            # Strip leading dot if snmpd sends .1.3.6... instead of 1.3.6...
            oid=$(printf '%s' "${REQ#.}" | tr -d .)
            eval "ret=\$getnext_${oid}"
            if [ -z "$ret" ] || [ "$ret" = "NONE" ]; then
                echo NONE
                continue
            fi
            ;;
        get)
            read -r REQ
            REQ="${REQ#.}"
            if [ "$REQ" = "$PLACE" ]; then
                echo NONE
                continue
            else
                ret="$REQ"
            fi
            ;;
        *)
            read -r REQ
            echo NONE
            continue
            ;;
    esac
        
    oid=$(printf '%s' "$ret" | tr -d .)
    eval "rtype=\$type_${oid}"
    if [ -n "$rtype" ]; then
        echo "$ret"
        echo "$rtype"
        eval "printf '%s\n' \"\$value_${oid}\""
    else
        echo NONE
    fi
done
