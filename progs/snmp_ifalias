#!/bin/sh

PLACE="1.3.6.1.2.1.31.1.1.1.18"
TMPDIR=/tmp/snmptmp
FILE="${TMPDIR}/out_ifalias"

load_cache() {
    [ -f "$FILE" ] || return
    local cur_mtime
    cur_mtime=$(date +%s -r "$FILE" 2>/dev/null)
    if [ "$cur_mtime" != "$LAST_MTIME" ]; then
        . "$FILE"
        LAST_MTIME="$cur_mtime"
    fi
}

load_cache

while read -r CMD; do
    load_cache

    case "$CMD" in
        PING)
            echo PONG
            continue
            ;;
        getnext)
            read -r REQ
            # Strip leading dot if snmpd sends .1.3.6... instead of 1.3.6...
            oid=$(printf '%s' "${REQ#.}" | tr -d .)
            eval "ret=\$getnext_${oid}"
            if [ -z "$ret" ] || [ "$ret" = "NONE" ]; then
                echo NONE
                continue
            fi
            ;;
        get)
            read -r REQ
            REQ="${REQ#.}"
            if [ "$REQ" = "$PLACE" ]; then
                echo NONE
                continue
            else
                ret="$REQ"
            fi
            ;;
        *)
            read -r REQ
            echo NONE
            continue
            ;;
    esac

    oid=$(printf '%s' "$ret" | tr -d .)
    eval "rtype=\$type_${oid}"
    if [ -n "$rtype" ]; then
        echo "$ret"
        echo "$rtype"
        eval "printf '%s\n' \"\$value_${oid}\""
    else
        echo NONE
    fi
done
