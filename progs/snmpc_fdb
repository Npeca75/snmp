#!/bin/sh

if [ -f "/opt/snmp/snmp.data" ]; then
    . /opt/snmp/snmp.data
else
    gZLC=$(printf "%02d" $(($(uci -q get system.@system[0].locid)+0)))
    gDSA=$(($(uci -q get system.@system[0].dsa)+0))
fi

PLACE='1.3.6.1.2.1.17.7.1.2.2.1.2'
TMPDIR=/tmp/snmptmp
BASEC=$(printf '%s' "$PLACE" | tr -d '.')
mkdir -p "$TMPDIR"

FILE="$TMPDIR/out_fdb"
VFILE="$TMPDIR/vlan_variables"

. "$VFILE"

TMP_LIST="$TMPDIR/.tmp_fdb_list.$$"
TMP_OUT="$TMPDIR/.tmp_fdb_out.$$"
TMP_LAST="$TMPDIR/.tmp_fdb_last.$$"

if [ "$gDSA" -eq 1 ]; then
    bridge fdb | while IFS=' ' read -r MAC _ DEV TYPE VLAN _; do
        [ "$TYPE" = "vlan" ] || continue
        case "$VLAN" in ''|*[!0-9]*) continue ;; esac

        if eval "[ -n \"\${VLID${VLAN}}\" ]"; then
            read -r IDX < "/sys/class/net/$DEV/ifindex"
            IFS=':'; set -- $MAC; IFS=' '
            printf '%s.%d.%d.%d.%d.%d.%d,%s\n' \
                "$VLAN" "0x$1" "0x$2" "0x$3" "0x$4" "0x$5" "0x$6" "$IDX"
        fi
    done > "$TMP_LIST"
else
    for DEV in $(grep -Eo 'br-vlan[0-9]+' /proc/net/dev | sort -u); do
        cat "/sys/class/net/$DEV/brforward" | hexdump -v -e '5/1 "%02x:" 1/1 "%02x " 1/1 "%u " 1/1 "%u " 1/4 "%u " 1/1 "%u " 3/1 "" "\n"' | \
        while IFS=' ' read MAC PORTLO ISLOCAL TIMER PORTHI; do
            if [ "$ISLOCAL" != "1" ]; then
                PORTNO=$((PORTHI << 16 | PORTLO))
                PTH=$(grep -l $PORTNO /sys/class/net/"$DEV"/lower_*/brport/port_no)
                PTH=${PTH/\/brport\/port_no/}
                IDX=$(cat $PTH/ifindex)
                VLAN=$(echo "$DEV" | grep -Eo "[0-9]+")
                IFS=':'; set -- $MAC
                echo $VLAN.$((0x$1)).$((0x$2)).$((0x$3)).$((0x$4)).$((0x$5)).$((0x$6)),$IDX >> "$TMP_LIST"
            fi
        done
    done
fi

P=$BASEC
echo "getnext_${P}='NONE'" > "$TMP_OUT"
sort -n -t'.' -k1,1 -k2,2 -k3,3 -k4,4 -k5,5 -k6,6 -k7,7 "$TMP_LIST" |
while IFS=',' read OID VAL; do
    NEWOIDE=$PLACE.$OID
    NEWOIDC=${BASEC}$(printf '%s' "$OID" | tr -d '.')
    echo "getnext_$P=$NEWOIDE" >> "$TMP_OUT"
    echo "value_$NEWOIDC='$VAL'" >> "$TMP_OUT"
    echo "type_$NEWOIDC='integer'" >> "$TMP_OUT"
    P=$NEWOIDC; echo "$P" > "$TMP_LAST"
done
P=$(cat "$TMP_LAST")
echo "getnext_${P}='NONE'" >> "$TMP_OUT"

mv "$TMP_OUT" "$FILE"
rm -rf "$TMP_LIST" "$TMP_LAST"
